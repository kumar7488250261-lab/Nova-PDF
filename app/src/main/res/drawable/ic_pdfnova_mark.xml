<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="72dp"
    android:height="72dp"
    android:viewportWidth="72"
    android:viewportHeight="72">

    <!-- Blue-to-purple outer accent / backing shadow (as in official brand asset) -->
    <path
        android:pathData="M14,10 L44,10 L62,28 L62,60 A6,6 0 0,1 56,66 L20,66 A6,6 0 0,1 14,60 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="14"
                android:startY="10"
                android:endX="62"
                android:endY="66"
                android:type="linear">
                <item android:offset="0.0" android:color="#0072FF" />
                <item android:offset="0.5" android:color="#4F46E5" />
                <item android:offset="1.0" android:color="#7C3AED" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- White Document Body -->
    <path
        android:pathData="M17,8 L43,8 L58,23 L58,58 A4,4 0 0,1 54,62 L21,62 A4,4 0 0,1 17,58 Z"
        android:fillColor="#FFFFFF" />

    <!-- Folded Corner with slight lavender gradient -->
    <path
        android:pathData="M43,8 L58,23 L46,23 A3,3 0 0,1 43,20 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="43"
                android:startY="8"
                android:endX="58"
                android:endY="23"
                android:type="linear">
                <item android:offset="0.0" android:color="#E0E7FF" />
                <item android:offset="1.0" android:color="#C7D2FE" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Stylized Geometric "N" -->
    <!-- Left upright: Cyan to Royal Blue -->
    <path
        android:pathData="M24,25 L30.5,25 L30.5,52 L24,52 A2.5,2.5 0 0,1 21.5,49.5 L21.5,27.5 A2.5,2.5 0 0,1 24,25 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="21.5"
                android:startY="25"
                android:endX="30.5"
                android:endY="52"
                android:type="linear">
                <item android:offset="0.0" android:color="#0072FF" />
                <item android:offset="0.5" android:color="#0284C7" />
                <item android:offset="1.0" android:color="#2563EB" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Diagonal slash: Royal Blue to Violet -->
    <path
        android:pathData="M22,25 L30.5,25 L50,52 L41.5,52 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="22"
                android:startY="25"
                android:endX="50"
                android:endY="52"
                android:type="linear">
                <item android:offset="0.0" android:color="#0062FF" />
                <item android:offset="0.5" android:color="#2563EB" />
                <item android:offset="1.0" android:color="#7C3AED" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Right upright: Violet to Indigo -->
    <path
        android:pathData="M41,25 L47.5,25 A2.5,2.5 0 0,1 50,27.5 L50,49.5 A2.5,2.5 0 0,1 47.5,52 L41,52 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="41"
                android:startY="25"
                android:endX="50"
                android:endY="52"
                android:type="linear">
                <item android:offset="0.0" android:color="#7C3AED" />
                <item android:offset="0.5" android:color="#6366F1" />
                <item android:offset="1.0" android:color="#4F46E5" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
