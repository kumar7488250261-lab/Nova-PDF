<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AndroidX SplashScreen theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0F172A</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.PDFNova</item>
    </style>

    <style name="Theme.PDFNova" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Application default theme mapping -->
    <style name="Theme.MyApplication" parent="Theme.App.Starting" />
</resources>
